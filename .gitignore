# data (raw downloads and generated layers are not committed - see data/README.md)
# data/raw/**/*.csv   -- re-enabled 2026-10-22, tracked via Git LFS so the team doesn't each re-download/re-register for FIRMS
# data/raw/**/*.zip   -- re-enabled 2026-10-22, tracked via Git LFS
# data/raw/**/*.json  -- re-enabled 2026-10-22, tracked via Git LFS
data/bronze/**/*.parquet
data/silver/**/*.parquet
data/gold/**/*.parquet
data/models/*
!data/models/.gitkeep
!data/*/.gitkeep

# python
__pycache__/
*.pyc
.venv/
venv/
*.egg-info/
.pytest_cache/
.ipynb_checkpoints/

# mlflow
mlruns/
mlartifacts/
mlflow.db

# airflow
dags/__pycache__/
logs/
airflow.db
airflow.cfg

# os / editor
.DS_Store
.vscode/
*.swp

# secrets: API keys live in .env, never committed
.env

# live downloads (re-fetched with python -m hazecast.refresh)
data/raw/**/*live*.csv

# auto-downloaded history (re-fetched with python -m hazecast.ingest.historical);
# the committed LFS files are the seed, these top them up
data/raw/pm25/*_datagov.csv
data/raw/pm25/*_rtapi_*.csv
data/raw/weather/*_hist_*.csv
data/raw/firms/fire_*_api_*.csv
data/raw/firms/fetch_log.json

# runtime outputs of inference / monitoring / generated reports
data/monitoring/
data/gold/*.tmp
reports/monitoring/
reports/data_quality/

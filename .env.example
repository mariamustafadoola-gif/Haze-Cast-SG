# Copy this file to .env and fill in your keys. .env is never committed.
# Free key: https://firms.modaps.eosdis.nasa.gov/api/map_key/
FIRMS_MAP_KEY=
# Optional, for higher rate limits on data.gov.sg
DATA_GOV_SG_API_KEY=
# Host ports (change if something else already uses them, e.g. another Airflow on 8080)
AIRFLOW_PORT=8080
MLFLOW_PORT=5000
API_PORT=8000
JUPYTER_PORT=8888
